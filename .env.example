# Relay configuration (apps/relay/src/config.ts). Copy to .env for local runs;
# on Railway set these as service variables. Empty values count as unset.

# development | test | production. The Docker image sets production.
NODE_ENV=development

# Listen address. "::" accepts IPv4 and IPv6 (Railway private networking needs IPv6).
RC_HOST=::

# Listen port. Falls back to PORT (injected by Railway), then 3000.
RC_PORT=3000

# Postgres connection URL. Falls back to DATABASE_URL; on Railway reference
# ${{Postgres.DATABASE_URL}}. Required in production; without it /health reports db "disabled".
RC_DATABASE_URL=postgres://rc:rc@localhost:5432/rc

# fatal | error | warn | info | debug | trace | silent
RC_LOG_LEVEL=info

# Directory with the PWA build (index.html). Defaults to apps/web/dist; the image uses /app/public.
RC_PUBLIC_DIR=

# Serve HTTPS directly (local LAN testing with mkcert only; Railway terminates TLS).
# Both must be set together. `pnpm dev:https` sets them for you.
RC_TLS_CERT_FILE=
RC_TLS_KEY_FILE=

# Injected by Railway; reported by /health and /api/version.
# RAILWAY_GIT_COMMIT_SHA=
