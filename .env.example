# Relay configuration (apps/relay/src/config.ts). Copy to .env for local runs;
# on Railway set these as service variables. Empty values count as unset.

# development | test | production. The Docker image sets production.
NODE_ENV=development

# Listen address. "::" accepts IPv4 and IPv6 (Railway private networking needs IPv6).
RC_HOST=::

# Listen port. Falls back to PORT (injected by Railway), then 3000.
RC_PORT=3000

# Postgres connection URL. Falls back to DATABASE_URL; on Railway reference
# ${{Postgres.DATABASE_URL}}. Required in production; without it /health reports db "disabled".
RC_DATABASE_URL=postgres://rc:rc@localhost:5432/rc

# fatal | error | warn | info | debug | trace | silent
RC_LOG_LEVEL=info

# Directory with the PWA build (index.html). Defaults to apps/web/dist; the image uses /app/public.
RC_PUBLIC_DIR=

# Serve HTTPS directly (local LAN testing with mkcert only; Railway terminates TLS).
# Both must be set together. `pnpm dev:https` sets them for you.
RC_TLS_CERT_FILE=
RC_TLS_KEY_FILE=

# WebAuthn relying-party id (D8/D9): the bare host name of the PWA (e.g. rc.example.com),
# never an IP address. Must equal RC_ORIGIN's host or a parent domain. Required in
# production; defaults to localhost. Changing it later invalidates every passkey.
RC_RP_ID=localhost

# The PWA origin (scheme://host[:port]) — the only origin accepted in WebAuthn client data
# and in the Origin header of state-changing /api requests. Required (and https) in
# production; defaults to http://localhost:3000. `pnpm dev:https` sets https://localhost:3443.
RC_ORIGIN=http://localhost:3000

# Reverse proxies in front of the relay whose X-Forwarded-For entry is trusted for the
# client IP (rate limits). 0-5; defaults to 1 in production (Railway's edge), else 0.
RC_TRUST_PROXY_HOPS=

# Web Push VAPID key pair (M0-12), base64url. Generate with `node dist/admin.js vapid-keys`.
# Set both or neither; unset disables push (the relay still boots). The private key is a
# secret: keep it in Railway variables only. Rotating it invalidates every phone subscription.
RC_VAPID_PUBLIC=
RC_VAPID_PRIVATE=

# VAPID contact (mailto: or https:) sent to push services. Defaults to RC_ORIGIN when that
# is https; required otherwise (e.g. local http development with VAPID keys set).
RC_VAPID_SUBJECT=

# Owner token for GET /api/admin/counters (32–256 printable ASCII characters). Unset
# disables the route. Generate with: openssl rand -base64 33
RC_ADMIN_TOKEN=

# Hub: `local` (default, one replica) or `pg` (replicas share devices over Postgres
# LISTEN/NOTIFY, ADR 0012; needs RC_DATABASE_URL or DATABASE_URL). `pg` also keeps
# WebAuthn challenges in Postgres so any replica can finish a ceremony (ADR 0016).
RC_HUB=

# Sentry DSN for relay error reports (M0-26, D16), https only. Unset disables reporting.
# Events carry exception types, scrubbed messages, stack frames and route metadata only.
# Check with `node dist/admin.js sentry-test`.
RC_SENTRY_DSN=

# Injected by Railway; reported by /health and /api/version.
# RAILWAY_GIT_COMMIT_SHA=
