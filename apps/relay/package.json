{
  "name": "@remote-control/relay",
  "version": "0.0.0",
  "private": true,
  "description": "Relay service: accounts, pairing, WebSocket hub and Web Push. Sees metadata only.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:https": "sh scripts/dev-https.sh",
    "build": "tsdown",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "migrate": "node dist/migrate.js",
    "admin": "node dist/admin.js",
    "test:pg-real": "vitest run --root ../.. --project pg-real --coverage.enabled=false"
  },
  "dependencies": {
    "@fastify/static": "10.1.5",
    "@fastify/websocket": "11.3.3",
    "@simplewebauthn/server": "14.0.3",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "web-push": "3.6.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@remote-control/crypto": "workspace:*",
    "@remote-control/log": "workspace:*",
    "@remote-control/protocol": "workspace:*",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "tsdown": "^0.23.0",
    "ws": "^8.22.0"
  }
}
