{
  "name": "remotectl",
  "version": "0.0.0",
  "description": "Home agent: bridges local AI coding agents to the phone over an end-to-end encrypted channel.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IvanBBaev/remote-control.git",
    "directory": "apps/agent"
  },
  "homepage": "https://github.com/IvanBBaev/remote-control#readme",
  "type": "module",
  "bin": {
    "remotectl": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      "./package.json": "./package.json"
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./hook": "./src/hook/run-hook.ts"
  },
  "scripts": {
    "build": "node scripts/check-argv-policy.mjs && tsdown src/cli.ts --no-config --platform node --target node22 --format esm --sourcemap --shims --no-dts --clean && tsdown src/hook/hook.ts --no-config --platform node --target node22 --format cjs --no-dts --no-clean"
  },
  "devDependencies": {
    "@remote-control/crypto": "workspace:*",
    "@remote-control/fake-claude-code": "workspace:*",
    "@remote-control/log": "workspace:*",
    "@remote-control/protocol": "workspace:*",
    "diff": "9.0.0",
    "fastify": "5.12.5",
    "tsdown": "^0.23.0",
    "uqr": "0.1.3",
    "zod": "^4.6.5",
    "zxing-wasm": "3.1.5"
  }
}
