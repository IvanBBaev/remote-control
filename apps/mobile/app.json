{
  "expo": {
    "name": "remote-control",
    "slug": "remote-control",
    "version": "0.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "remotecontrol",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0D10",
    "ios": {
      "bundleIdentifier": "dev.ivanbaev.remotecontrol",
      "supportsTablet": false
    },
    "android": {
      "package": "dev.ivanbaev.remotecontrol",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0D10",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
