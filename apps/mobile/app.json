{
  "expo": {
    "name": "remote-control",
    "slug": "remote-control",
    "version": "0.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "remotecontrol",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0D10",
    "ios": {
      "bundleIdentifier": "dev.ivanbaev.remotecontrol",
      "supportsTablet": false,
      "entitlements": {
        "com.apple.security.application-groups": ["group.dev.ivanbaev.remotecontrol"]
      },
      "infoPlist": {
        "NSFaceIDUsageDescription": "Face ID confirms each Allow before it reaches your agent."
      }
    },
    "android": {
      "package": "dev.ivanbaev.remotecontrol",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "@bacons/apple-targets",
      ["expo-notifications", { "mode": "development" }],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0D10",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
