{
  // Expo's base sets the React Native resolution (`customConditions`, `module: preserve`);
  // the strictness flags match tsconfig.base.json. `tsc -b` needs a composite project, so
  // declarations go to a cache folder nothing reads.
  "extends": "./node_modules/expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowJs": false,
    "noEmit": false,
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "node_modules/.cache/tsc",
    "tsBuildInfoFile": "node_modules/.cache/tsc/tsconfig.tsbuildinfo",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"],
  "references": [
    { "path": "../../packages/crypto" },
    { "path": "../../packages/phone-core" },
    { "path": "../../packages/protocol" }
  ]
}
